VITE_SUPABASE_URL=https://xxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Only needed to run scripts/seed-*.ts (uploading media + seeding the
# exercises_catalog table). Never commit — never expose to the browser.
# Get it from Supabase → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# Optional override for the local path to the hasaneyldrm/exercises-dataset
# checkout. Defaults to a hard-coded fallback in scripts/_shared.ts.
EXERCISES_DATASET_PATH=
